{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account, login credentials, and balance profile",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "accountNumber": { "type": "string" },
        "passwordHash": { "type": "string" },
        "name": { "type": "string" },
        "memberId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "superiorId": { "type": "string" },
        "packageLevel": { "type": "string" },
        "balance": { "type": "number" },
        "bkashName": { "type": "string" },
        "bkashPhone": { "type": "string" },
        "bkashOptional": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["phone", "passwordHash"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Team member record under a inviter or superior",
      "type": "object",
      "properties": {
        "superiorPhone": { "type": "string" },
        "memberPhone": { "type": "string" },
        "memberId": { "type": "string" },
        "tier": { "type": "number" },
        "level": { "type": "string" },
        "status": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["superiorPhone", "memberPhone"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Deposit, withdrawal, or balance transaction record",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "ratio": { "type": "string" },
        "actual": { "type": "number" },
        "status": { "type": "string" },
        "method": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["phone", "type", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "/team/{teamMemberId}": {
      "schema": "TeamMember",
      "description": "Team members list"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial records for recharges, withdrawals and earnings"
    }
  }
}
