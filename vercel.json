{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/crypto/check/:userId",
      "destination": "/api/crypto?action=check&userId=:userId"
    },
    {
      "source": "/api/crypto/:userId",
      "destination": "/api/crypto?action=address&userId=:userId"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|admin).*)",
      "destination": "/index.html"
    }
  ]
}
