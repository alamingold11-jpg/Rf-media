rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: registration, login lookup, profile & balance updates
    match /users/{userId} {
      allow read, write: if true;
    }

    // Team collection: team member relationships and status
    match /team/{teamMemberId} {
      allow read, write: if true;
    }

    // Transactions collection: deposit and withdrawal records
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
  }
}
